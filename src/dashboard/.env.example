# fal.ai — "Generar look con modelo" on the run view.
# Copy to .env.local (gitignored) and restart the dashboard.
#   cp src/dashboard/.env.example src/dashboard/.env.local
FAL_KEY=

# Optional. Any fal model taking {prompt, image_urls} works.
# FAL_MODEL=fal-ai/nano-banana/edit
# FAL_PROMPT=

# Optional. Where the Python bridge listens.
# NEXT_PUBLIC_XFOLD_BRIDGE_URL=http://127.0.0.1:8765

# Optional. Point the try-on call somewhere other than fal.run (gateway, stub).
# FAL_BASE_URL=https://fal.run
