# OpenAI — "Generar look con modelo" on the run view.
# Copy to .env.local (gitignored) and restart the dashboard.
#   cp src/dashboard/.env.example src/dashboard/.env.local
OPENAI_API_KEY=

# Optional. Image model used for the try-on edit.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRYON_PROMPT=

# Optional. Where the Python bridge listens.
# NEXT_PUBLIC_XFOLD_BRIDGE_URL=http://127.0.0.1:8765
