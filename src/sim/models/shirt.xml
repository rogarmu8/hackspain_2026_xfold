<!-- XFOLD T-shirt — inextensible edges + bend FEM (not cotton constants).
     Stretch FEM (elastic2d=both) + spring claws stretched the T into a spike.
     Starter from issue #1433 / poncho_edgeequality:
       edge equality, young=3e3, poisson=0, elastic2d=bend
     Floor support is per-vertex spheres (apply_shirt_config), not the
     50-contact flex-vs-plane pair. Mesh density is a looks/drape knob. -->
<mujoco model="xfold-shirt">
  <asset>
    <!-- White T + tiny AlphaFold α^x. UVs in shirt_t.obj cover the panel once. -->
    <texture name="shirt_print" type="2d" file="shirt_print.png"/>
    <material name="shirt_cloth" texture="shirt_print" rgba="1 1 1 1"
              specular="0.02" shininess="0.01" reflectance="0"/>
  </asset>

  <worldbody>
    <flexcomp name="shirt" type="mesh" dim="2" file="shirt_t.obj"
              radius="0.003" mass="0.18" flatskin="false"
              pos="0.15 0 0.098" euler="0 0 0"
              material="shirt_cloth">
      <contact internal="false" selfcollide="none" passive="false"
               solref="0.005 1" solimp="0.95 0.99 0.001"
               friction="0.5 0.005 0.0001" condim="3"/>
      <edge equality="true" damping="0.1"/>
      <elasticity young="3e3" poisson="0" thickness="0.001"
                  elastic2d="bend" damping="0.02"/>
    </flexcomp>
  </worldbody>
</mujoco>
