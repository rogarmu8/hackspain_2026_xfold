<!-- XFOLD T-shirt — CLOTH3D flat mesh + MuJoCo flexcomp.
     Asset: shirt_cloth3d.obj (161 verts / 268 tris, single layer)
       python -m xfold.convert_cloth3d_mesh <cloth3d_flat.obj> --spacing 0.050

     Vertex count is a physics budget, not a looks knob. MuJoCo caps a
     flex-vs-geom pair at mjMAXCONPAIR = 50 contacts, however many vertices
     touch. At 365 verts, 363 lay on the floor competing for 50 slots, the
     unsupported ones hung ~6 mm through the plane and the support pattern
     reshuffled every step — a permanent 7 Hz ripple. At 161 verts the sheet
     asks for ~51 contacts, so it is fully supported: nothing clips and the
     resting ripple drops from 1.6 mm to 0.15 mm. See SOLUTION.md §4.3.

     CG beats Newton here (equality-heavy, ~480 constraints) and is what buys
     real time. No joint damping: it is absolute-frame drag, so it slowed free
     fall by 1.5x and read as slow motion. The scene owns <option>. -->
<mujoco model="xfold-shirt">
  <asset>
    <!-- Matte and desaturated. A saturated rgba with MuJoCo's default specular
         is what made people call the cloth slime: the highlights read as a wet
         surface and they flatten every fold. Cube textures come out white on a
         flex, so the fabric look has to come from the shading. -->
    <material name="shirt_cloth" rgba="0.20 0.31 0.46 1"
              specular="0.02" shininess="0.01" reflectance="0"/>
  </asset>

  <worldbody>
    <flexcomp name="shirt" type="mesh" dim="2" file="shirt_cloth3d.obj"
              radius="0.004" mass="0.22" flatskin="false"
              pos="0.15 0 0.55" euler="0.25 0.08 0.3"
              material="shirt_cloth">
      <contact internal="false" selfcollide="bvh"
               solref="0.005 1.2" solimp="0.99 0.999 0.0002"
               friction="1.0 0.05 0.0001" condim="3"/>
      <edge equality="true" damping="0.5"/>
    </flexcomp>
  </worldbody>
</mujoco>
