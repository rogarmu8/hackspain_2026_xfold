<!--
  Shared plant stub — docs/INTEGRATION_CONTRACT.md §4b
  - Viewport MJPEG loads this file (or press_cell via scene.build) and requires
    <camera name="overview"/>. Do not rename that camera.
  - The flex T lives in shirt.xml. The loading cell with the UR5e is press_cell.xml.
-->
<mujoco model="xfold-cell-stub">
  <!-- CG, not Newton: the cloth is equality-heavy and CG runs it ~2x faster
       at the same accuracy. 500 Hz physics per SOLUTION.md §6. -->
  <option gravity="0 0 -9.81" timestep="0.002" integrator="discrete" solver="CG"/>
  <visual>
    <global offwidth="960" offheight="540"/>
    <headlight diffuse="0.45 0.45 0.45" ambient="0.3 0.3 0.32" specular="0.1 0.1 0.1"/>
  </visual>

  <include file="shirt.xml"/>

  <worldbody>
    <light pos="0 0 2.2" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="1.8 1.2 0.05" rgba="0.18 0.18 0.2 1"/>
    <camera name="overview" pos="-1.4 -1.4 1.1" xyaxes="0.7 -0.7 0 0.35 0.35 0.87"/>

    <body name="bin" pos="-0.55 0 0.12">
      <geom type="box" size="0.22 0.18 0.01" rgba="0.28 0.22 0.16 1"/>
      <geom type="box" size="0.22 0.01 0.12" pos="0 0.17 0.12" rgba="0.32 0.24 0.18 1"/>
      <geom type="box" size="0.22 0.01 0.12" pos="0 -0.17 0.12" rgba="0.32 0.24 0.18 1"/>
      <geom type="box" size="0.01 0.18 0.12" pos="0.21 0 0.12" rgba="0.32 0.24 0.18 1"/>
      <geom type="box" size="0.01 0.18 0.12" pos="-0.21 0 0.12" rgba="0.32 0.24 0.18 1"/>
    </body>

    <body name="press_bed" pos="0.15 0 0.08">
      <!-- Sized for the T plus sleeves. Sticky while folding (ninja). -->
      <geom type="box" size="0.48 0.40 0.015" rgba="0.55 0.55 0.58 1"
            friction="1.2 0.05 0.0001" solref="0.005 1.2" solimp="0.99 0.999 0.0002"/>
    </body>
    <body name="press_platen" pos="0.15 0 0.85">
      <geom type="box" size="0.48 0.40 0.02" rgba="0.45 0.45 0.5 1"/>
    </body>

    <body name="chute" pos="0.72 0 0.16" euler="0 0.65 0">
      <geom type="box" size="0.32 0.16 0.008" rgba="0.12 0.28 0.72 1"/>
    </body>
    <body name="bag" pos="1.05 0 0.07">
      <geom type="box" size="0.13 0.10 0.06" rgba="0.78 0.78 0.72 0.4"/>
    </body>
  </worldbody>
</mujoco>
