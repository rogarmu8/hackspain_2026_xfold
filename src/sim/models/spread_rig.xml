<!--
  Dual conveyor product turner (infeed, upstream of the linear belt).

  Two independent lanes run along +X. Both carry the shirt forward; a
  speed difference yaws it about +Z; then the lanes resync. All deco.
  Contact is belt_top_orient_l / belt_top_orient_r in line.xml.

  Station x = -2.10 .. -1.00, y = +/-0.48. Shirt vertices sit at 0.565.
-->
<mujoco model="xfold-spread-rig">
  <worldbody>
    <!-- Frame under the two decks. -->
    <geom name="orient_bed" class="deco" type="box" size="0.56 0.50 0.028"
          pos="-1.55 0 0.508" material="steel"/>
    <geom name="orient_foot_0" class="deco" type="cylinder" size="0.040 0.008"
          pos="-2.02  0.46 0.008" material="panel_grey"/>
    <geom name="orient_foot_1" class="deco" type="cylinder" size="0.040 0.008"
          pos="-2.02 -0.46 0.008" material="panel_grey"/>
    <geom name="orient_foot_2" class="deco" type="cylinder" size="0.040 0.008"
          pos="-1.08  0.46 0.008" material="panel_grey"/>
    <geom name="orient_foot_3" class="deco" type="cylinder" size="0.040 0.008"
          pos="-1.08 -0.46 0.008" material="panel_grey"/>
    <geom name="orient_leg_0" class="deco" type="box" size="0.028 0.028 0.24"
          pos="-2.02  0.46 0.248" material="steel"/>
    <geom name="orient_leg_1" class="deco" type="box" size="0.028 0.028 0.24"
          pos="-2.02 -0.46 0.248" material="steel"/>
    <geom name="orient_leg_2" class="deco" type="box" size="0.028 0.028 0.24"
          pos="-1.08  0.46 0.248" material="steel"/>
    <geom name="orient_leg_3" class="deco" type="box" size="0.028 0.028 0.24"
          pos="-1.08 -0.46 0.248" material="steel"/>
    <geom name="orient_brace_l" class="deco" type="box" size="0.46 0.012 0.012"
          pos="-1.55  0.46 0.12" material="steel"/>
    <geom name="orient_brace_r" class="deco" type="box" size="0.46 0.012 0.012"
          pos="-1.55 -0.46 0.12" material="steel"/>

    <!-- Two decks. Gap along y = 0 is the split the product straddles. -->
    <geom name="orient_belt_l" class="deco" type="box" size="0.550 0.230 0.0115"
          pos="-1.55  0.250 0.5495" material="belt"/>
    <geom name="orient_belt_r" class="deco" type="box" size="0.550 0.230 0.0115"
          pos="-1.55 -0.250 0.5495" material="belt"/>
    <geom name="orient_gap" class="deco" type="box" size="0.550 0.014 0.0116"
          pos="-1.55 0 0.5496" material="slat"/>
    <geom name="orient_rail_l" class="deco" type="box" size="0.550 0.018 0.040"
          pos="-1.55  0.505 0.518" material="steel"/>
    <geom name="orient_rail_r" class="deco" type="box" size="0.550 0.018 0.040"
          pos="-1.55 -0.505 0.518" material="steel"/>

    <!-- End rollers, one pair per lane. -->
    <geom name="orient_roll_lin" class="deco" type="cylinder" size="0.028 0.230"
          pos="-2.10  0.250 0.530" euler="1.5708 0 0" material="roller"/>
    <geom name="orient_roll_lout" class="deco" type="cylinder" size="0.028 0.230"
          pos="-1.00  0.250 0.530" euler="1.5708 0 0" material="roller"/>
    <geom name="orient_roll_rin" class="deco" type="cylinder" size="0.028 0.230"
          pos="-2.10 -0.250 0.530" euler="1.5708 0 0" material="roller"/>
    <geom name="orient_roll_rout" class="deco" type="cylinder" size="0.028 0.230"
          pos="-1.00 -0.250 0.530" euler="1.5708 0 0" material="roller"/>

    <!-- Independent drives: left gearbox on +Y, right on -Y. -->
    <geom name="orient_drive_l" class="deco" type="box" size="0.070 0.050 0.042"
          pos="-1.00  0.560 0.430" material="panel_grey"/>
    <geom name="orient_drive_l_m" class="deco" type="cylinder" size="0.032 0.028"
          pos="-1.00  0.560 0.500" material="steel"/>
    <geom name="orient_drive_r" class="deco" type="box" size="0.070 0.050 0.042"
          pos="-1.00 -0.560 0.430" material="panel_grey"/>
    <geom name="orient_drive_r_m" class="deco" type="cylinder" size="0.032 0.028"
          pos="-1.00 -0.560 0.500" material="steel"/>

    <!-- Transfer bar onto the linear belt: sits in the overlap, not a hole. -->
    <geom name="orient_transfer" class="deco" type="box" size="0.012 0.485 0.012"
          pos="-1.01 0 0.548" material="slat"/>

    <!-- Slats: Python scrolls each lane at that belt's speed. -->
    <geom name="orient_slat_l_0" class="deco" type="box" size="0.010 0.225 0.0006" pos="-2.10  0.250 0.5616" material="slat"/>
    <geom name="orient_slat_l_1" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.96  0.250 0.5616" material="slat"/>
    <geom name="orient_slat_l_2" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.82  0.250 0.5616" material="slat"/>
    <geom name="orient_slat_l_3" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.68  0.250 0.5616" material="slat"/>
    <geom name="orient_slat_l_4" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.54  0.250 0.5616" material="slat"/>
    <geom name="orient_slat_l_5" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.40  0.250 0.5616" material="slat"/>
    <geom name="orient_slat_l_6" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.26  0.250 0.5616" material="slat"/>
    <geom name="orient_slat_l_7" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.12  0.250 0.5616" material="slat"/>
    <geom name="orient_slat_r_0" class="deco" type="box" size="0.010 0.225 0.0006" pos="-2.10 -0.250 0.5616" material="slat"/>
    <geom name="orient_slat_r_1" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.96 -0.250 0.5616" material="slat"/>
    <geom name="orient_slat_r_2" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.82 -0.250 0.5616" material="slat"/>
    <geom name="orient_slat_r_3" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.68 -0.250 0.5616" material="slat"/>
    <geom name="orient_slat_r_4" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.54 -0.250 0.5616" material="slat"/>
    <geom name="orient_slat_r_5" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.40 -0.250 0.5616" material="slat"/>
    <geom name="orient_slat_r_6" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.26 -0.250 0.5616" material="slat"/>
    <geom name="orient_slat_r_7" class="deco" type="box" size="0.010 0.225 0.0006" pos="-1.12 -0.250 0.5616" material="slat"/>
  </worldbody>
</mujoco>
