<!--
  Dual-arm align station (infeed, upstream of the linear belt).

  The infeed used to be two conveyors that yawed the product by running at
  different speeds. It is one plain belt now, and the heading is corrected by
  two pedestal robot arms standing either side of it: each drops a suction
  wrist onto its half of the garment, the pair lifts it clear of the belt,
  swings it round to collar-downstream and lays it back down. They square the
  position, not the wrinkles — the press still does those.

  Station x = -2.10 .. -1.00, belt half-width 0.485 (same deck as belt 1, so
  a sleeve span of 0.91 m lies flat on it). Shirt vertices sit at 0.565.
  Contact is belt_top_in in line.xml; every geom here is deco.

  Both arms are 2-link on a yaw turret, same build as the QC reject arm, and
  xfold.align poses their mocap links with the shared 2-link IK. Shoulders
  are at y = +/-0.80, outside the belt rails, and 0.80 m up so the links come
  down onto the belt rather than across it.
-->
<mujoco model="xfold-align-rig">
  <worldbody>
    <!-- Frame under the single infeed deck. -->
    <geom name="in_bed" class="deco" type="box" size="0.55 0.45 0.025"
          pos="-1.55 0 0.508" material="steel"/>
    <geom name="in_rail_l" class="deco" type="box" size="0.55 0.020 0.045"
          pos="-1.55  0.505 0.515" material="steel"/>
    <geom name="in_rail_r" class="deco" type="box" size="0.55 0.020 0.045"
          pos="-1.55 -0.505 0.515" material="steel"/>
    <geom name="in_roll_in" class="deco" type="cylinder" size="0.032 0.485"
          pos="-2.10 0 0.530" euler="1.5708 0 0" material="roller"/>
    <geom name="in_leg_0" class="deco" type="box" size="0.03 0.03 0.25" pos="-2.02  0.41 0.25" material="steel"/>
    <geom name="in_leg_1" class="deco" type="box" size="0.03 0.03 0.25" pos="-2.02 -0.41 0.25" material="steel"/>
    <geom name="in_leg_2" class="deco" type="box" size="0.03 0.03 0.25" pos="-1.06  0.41 0.25" material="steel"/>
    <geom name="in_leg_3" class="deco" type="box" size="0.03 0.03 0.25" pos="-1.06 -0.41 0.25" material="steel"/>
    <geom name="in_foot_0" class="deco" type="cylinder" size="0.040 0.008" pos="-2.02  0.41 0.008" material="panel_grey"/>
    <geom name="in_foot_1" class="deco" type="cylinder" size="0.040 0.008" pos="-2.02 -0.41 0.008" material="panel_grey"/>
    <geom name="in_foot_2" class="deco" type="cylinder" size="0.040 0.008" pos="-1.06  0.41 0.008" material="panel_grey"/>
    <geom name="in_foot_3" class="deco" type="cylinder" size="0.040 0.008" pos="-1.06 -0.41 0.008" material="panel_grey"/>
    <geom name="in_brace_l" class="deco" type="box" size="0.46 0.012 0.012" pos="-1.55  0.44 0.12" material="steel"/>
    <geom name="in_brace_r" class="deco" type="box" size="0.46 0.012 0.012" pos="-1.55 -0.44 0.12" material="steel"/>
    <!-- One drive, on the aisle side. -->
    <geom name="in_drive" class="deco" type="box" size="0.070 0.050 0.042" pos="-1.05 -0.560 0.430" material="panel_grey"/>
    <geom name="in_drive_motor" class="deco" type="cylinder" size="0.032 0.028" pos="-1.05 -0.560 0.500" material="steel"/>
    <!-- Transfer bar onto the linear belt: sits in the overlap, not a hole. -->
    <geom name="in_transfer" class="deco" type="box" size="0.012 0.485 0.012"
          pos="-1.01 0 0.548" material="slat"/>

    <!-- Left arm pedestal (+Y). -->
    <body name="align_l_base" pos="-1.55 0.80 0">
      <geom name="align_l_foot" class="deco" type="cylinder" size="0.13 0.016" pos="0 0 0.016" material="steel"/>
      <geom name="align_l_column" class="deco" type="cylinder" size="0.058 0.38" pos="0 0 0.404" material="steel"/>
      <geom name="align_l_cap" class="deco" type="cylinder" size="0.072 0.04" pos="0 0 0.80" material="panel_grey"/>
    </body>
    <body name="align_l_yaw" mocap="true" pos="-1.55 0.80 0.80">
      <geom name="align_l_turret" class="deco" type="cylinder" size="0.064 0.035" pos="0 0 0.01" material="panel_grey"/>
      <geom name="align_l_horn" class="deco" type="box" size="0.05 0.028 0.022" pos="0.04 0 0.02" material="flap"/>
    </body>
    <body name="align_l_upper" mocap="true" pos="-1.55 0.80 0.80">
      <geom name="align_l_upper_tube" class="deco" type="cylinder" size="0.036 0.31" pos="0 0 0.31" material="steel"/>
      <geom name="align_l_elbow" class="deco" type="sphere" size="0.046" pos="0 0 0.62" material="panel_grey"/>
    </body>
    <body name="align_l_fore" mocap="true" pos="-1.55 0.18 0.80">
      <geom name="align_l_fore_tube" class="deco" type="cylinder" size="0.030 0.34" pos="0 0 0.34" material="steel"/>
      <geom name="align_l_wrist" class="deco" type="sphere" size="0.038" pos="0 0 0.68" material="panel_grey"/>
    </body>
    <!-- Wrist plate: a small suction array, so the grip is a patch, not a point. -->
    <body name="align_l_cup" mocap="true" pos="-1.55 0.30 0.70">
      <geom name="align_l_cup_plate" class="deco" type="box" size="0.062 0.040 0.006" pos="0 0 0.030" material="panel_grey"/>
      <geom name="align_l_cup_0" class="deco" type="cylinder" size="0.026 0.008" pos="-0.036 0 0.008" material="suction"/>
      <geom name="align_l_cup_1" class="deco" type="cylinder" size="0.026 0.008" pos="0.036 0 0.008" material="suction"/>
      <geom name="align_l_cup_stem" class="deco" type="cylinder" size="0.011 0.05" pos="0 0 0.082" material="chrome"/>
    </body>

    <!-- Right arm pedestal (-Y), mirrored. -->
    <body name="align_r_base" pos="-1.55 -0.80 0">
      <geom name="align_r_foot" class="deco" type="cylinder" size="0.13 0.016" pos="0 0 0.016" material="steel"/>
      <geom name="align_r_column" class="deco" type="cylinder" size="0.058 0.38" pos="0 0 0.404" material="steel"/>
      <geom name="align_r_cap" class="deco" type="cylinder" size="0.072 0.04" pos="0 0 0.80" material="panel_grey"/>
    </body>
    <body name="align_r_yaw" mocap="true" pos="-1.55 -0.80 0.80">
      <geom name="align_r_turret" class="deco" type="cylinder" size="0.064 0.035" pos="0 0 0.01" material="panel_grey"/>
      <geom name="align_r_horn" class="deco" type="box" size="0.05 0.028 0.022" pos="0.04 0 0.02" material="flap"/>
    </body>
    <body name="align_r_upper" mocap="true" pos="-1.55 -0.80 0.80">
      <geom name="align_r_upper_tube" class="deco" type="cylinder" size="0.036 0.31" pos="0 0 0.31" material="steel"/>
      <geom name="align_r_elbow" class="deco" type="sphere" size="0.046" pos="0 0 0.62" material="panel_grey"/>
    </body>
    <body name="align_r_fore" mocap="true" pos="-1.55 -0.18 0.80">
      <geom name="align_r_fore_tube" class="deco" type="cylinder" size="0.030 0.34" pos="0 0 0.34" material="steel"/>
      <geom name="align_r_wrist" class="deco" type="sphere" size="0.038" pos="0 0 0.68" material="panel_grey"/>
    </body>
    <body name="align_r_cup" mocap="true" pos="-1.55 -0.30 0.70">
      <geom name="align_r_cup_plate" class="deco" type="box" size="0.062 0.040 0.006" pos="0 0 0.030" material="panel_grey"/>
      <geom name="align_r_cup_0" class="deco" type="cylinder" size="0.026 0.008" pos="-0.036 0 0.008" material="suction"/>
      <geom name="align_r_cup_1" class="deco" type="cylinder" size="0.026 0.008" pos="0.036 0 0.008" material="suction"/>
      <geom name="align_r_cup_stem" class="deco" type="cylinder" size="0.011 0.05" pos="0 0 0.082" material="chrome"/>
    </body>
  </worldbody>
</mujoco>
