<!-- Shirt-only playground: T panel, inextensible edges + bend FEM.
     Ground contacts are per-vertex spheres; claws are mocap connects
     added at compile (shirt.toml / apply_shirt_config). -->
<mujoco model="xfold-shirt-playground">
  <option gravity="0 0 -9.81" timestep="0.002" integrator="discrete" solver="CG"
          iterations="80" tolerance="1e-6" cone="elliptic"/>
  <size nconmax="4000"/>
  <visual>
    <!-- Low specular everywhere: sharp highlights are what made the cloth
         look wet, and they wash out the folds that sell it as fabric. -->
    <headlight diffuse="0.45 0.45 0.45" ambient="0.3 0.3 0.32" specular="0.1 0.1 0.1"/>
    <global offwidth="1280" offheight="800"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="300" height="300"
             rgb1="0.2 0.2 0.22" rgb2="0.24 0.24 0.26"/>
    <material name="floor_mat" texture="grid" texrepeat="6 6"
              specular="0.05" shininess="0.02" reflectance="0"/>
    <texture name="shirt_print" type="2d" file="shirt_print.png"/>
    <material name="shirt_cloth" texture="shirt_print" rgba="1 1 1 1"
              specular="0.02" shininess="0.01" reflectance="0"/>
  </asset>

  <statistic center="0 0 0.12" extent="1.0"/>

  <worldbody>
    <light name="key" pos="0.4 0.4 2.0" dir="-0.2 -0.2 -1"
           diffuse="0.75 0.75 0.78" specular="0.1 0.1 0.1"/>
    <light name="fill" pos="-0.6 -0.4 1.5" dir="0.3 0.2 -1"
           diffuse="0.3 0.3 0.34" specular="0 0 0"/>
    <geom name="floor" type="plane" size="1.5 1.5 0.05"
          material="floor_mat" friction="0.5 0.005 0.0001"
          solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <camera name="play" pos="0.95 -1.05 0.75" xyaxes="0.75 0.65 0 -0.25 0.3 0.92"/>

    <!-- 3D button: double-click it (or press N) to run the ninja fold. -->
    <body name="ninja_button" mocap="true" pos="0.58 -0.40 0.08">
      <geom name="ninja_button" type="box" size="0.13 0.05 0.018"
            rgba="0.92 0.58 0.12 1" contype="0" conaffinity="0"/>
    </body>

    <flexcomp name="shirt" type="mesh" dim="2" file="shirt_t.obj"
              radius="0.003" mass="0.18" flatskin="false"
              pos="0 0 0.005" euler="0 0 0"
              material="shirt_cloth">
      <contact internal="false" selfcollide="none" passive="false"
               solref="0.005 1" solimp="0.95 0.99 0.001"
               friction="0.5 0.005 0.0001" condim="3"/>
      <edge equality="true" damping="0.1"/>
      <elasticity young="3e3" poisson="0" thickness="0.001"
                  elastic2d="bend" damping="0.02"/>
    </flexcomp>
  </worldbody>
</mujoco>
