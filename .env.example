# Local settings for the Isaac Sim GPU box (src/isaac). Copy to .env
# (gitignored) and fill in. Read by src/isaac/scripts/*.sh and by
# `moon run dashboard:dev-isaac` / `moon run xfold:dev-isaac`.

# SSH login and key for the box.
XFOLD_ISAAC_HOST=ubuntu@<box-ip>
XFOLD_ISAAC_KEY=~/path/to/key.pem
# YES once you have read NVIDIA's Omniverse EULA; Isaac will not start without it.
XFOLD_ISAAC_ACCEPT_EULA=

# Where the Isaac dashboard finds the Isaac bridge. By default the bridge
# listens on the box's own 127.0.0.1:8765 and `moon run isaac:bridge` forwards
# it over SSH to this local port, so nothing on the box is exposed.
XFOLD_ISAAC_BRIDGE_PORT=8766
# Or skip the tunnel and point at a bridge you can reach directly, e.g. one
# started with `--host 0.0.0.0` behind an open port (it has no auth):
# XFOLD_ISAAC_BRIDGE_URL=http://<box-ip>:8765
# Port for the Isaac dashboard, so it can run next to the MuJoCo one (3000).
XFOLD_ISAAC_DASHBOARD_PORT=3001
